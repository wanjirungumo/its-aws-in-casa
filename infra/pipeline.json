{
  "name": "bacheca-pipeline",
  "executionMode": "SUPERSEDED",
  "pipelineType": "V1",
  "roleArn": "arn:aws:iam::000000000000:role/ruolo-pipeline",
  "artifactStore": {
    "type": "S3",
    "location": "bacheca-artefatti"
  },
  "version": 1,
  "stages": [
    {
      "name": "Sorgente",
      "actions": [
        {
          "name": "PrendiLoZip",
          "actionTypeId": {
            "category": "Source",
            "owner": "AWS",
            "provider": "S3",
            "version": "1"
          },
          "runOrder": 1,
          "configuration": {
            "S3Bucket": "bacheca-sorgente",
            "S3ObjectKey": "sorgente.zip",
            "PollForSourceChanges": "false"
          },
          "inputArtifacts": [],
          "outputArtifacts": [{ "name": "CodiceSorgente" }]
        }
      ]
    },
    {
      "name": "Build",
      "actions": [
        {
          "name": "CompilaETesta",
          "actionTypeId": {
            "category": "Build",
            "owner": "AWS",
            "provider": "CodeBuild",
            "version": "1"
          },
          "runOrder": 1,
          "configuration": {
            "ProjectName": "bacheca-build-pipeline"
          },
          "inputArtifacts": [{ "name": "CodiceSorgente" }],
          "outputArtifacts": [{ "name": "SitoPronto" }]
        }
      ]
    },
    {
      "name": "Deploy",
      "actions": [
        {
          "name": "PubblicaSuS3",
          "actionTypeId": {
            "category": "Deploy",
            "owner": "AWS",
            "provider": "S3",
            "version": "1"
          },
          "runOrder": 1,
          "configuration": {
            "BucketName": "bacheca-cfn",
            "Extract": "true"
          },
          "inputArtifacts": [{ "name": "SitoPronto" }],
          "outputArtifacts": []
        }
      ]
    }
  ]
}
