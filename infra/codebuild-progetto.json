{
  "name": "bacheca-build",
  "description": "Fase 3: build isolata, sorgente preso da uno zip su S3",
  "source": {
    "type": "S3",
    "location": "bacheca-sorgente/sorgente.zip"
  },
  "artifacts": {
    "type": "S3",
    "location": "bacheca-artefatti",
    "name": "sito-pronto.zip",
    "packaging": "ZIP"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/standard:5.0",
    "computeType": "BUILD_GENERAL1_SMALL"
  },
  "serviceRole": "arn:aws:iam::000000000000:role/ruolo-pipeline"
}
