# Copia questo file in .env e incolla il tuo token LocalStack.
# Dove si prende: app.localstack.cloud -> Auth Token (dopo esserti registrato
# e aver attivato il piano studente con il GitHub Student Pack).
#
# Senza token LocalStack parte lo stesso, ma solo con i servizi gratuiti:
# niente CodeBuild, niente CodePipeline.

LOCALSTACK_AUTH_TOKEN=ls-xxxxxxxxxxxxxxxx

# Se proprio non riesci a registrarti, puoi usare la vecchia immagine community
# (nessun token, nessun CodeBuild/CodePipeline):
# LOCALSTACK_TAG=3.8
